# ===== Backend (backend/.env or process env). NEVER commit real values. =====
APP_ENV=development
# SQLite works out of the box. For Supabase use the *pooler or direct* Postgres URI, e.g.:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./trustloop.db
CORS_ORIGINS=http://localhost:3000
# Required: random string, 32+ chars. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
APPROVAL_TTL_MINUTES=30

# Gemini (https://aistudio.google.com/apikey). Model is configurable; verify availability for your key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically if the primary model keeps failing (503/504 overload, wrong model name). The UI says when the fallback answered.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_RETRIES=2
GEMINI_TIMEOUT_SECONDS=20
# Leave empty (model default). Some models reject thinking_level="minimal" (e.g. 3.8 Flash); if set and rejected, the call retries without it.
GEMINI_THINKING_LEVEL=

# Optional: override the Gemini endpoint (proxy). Leave empty for Google's default.
GEMINI_BASE_URL=

# Product sources: "curated" = built-in demo catalog; "dummyjson" = free demo API (dummyjson.com) with real product photos across
# ~24 categories. It is a FAKE store for prototyping, not a real retailer. Use PRODUCT_PROVIDERS=curated to disable network calls.
PRODUCT_PROVIDERS=curated,dummyjson
DUMMYJSON_BASE_URL=https://dummyjson.com
PROVIDER_TIMEOUT_SECONDS=8
# Demo FX for provider USD prices. Keep equal to INR_PER_UNIT_PAYPAL_CURRENCY so the PayPal USD charge equals the provider's USD price.
PROVIDER_USD_TO_INR=83.00

# PayPal Sandbox REST app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app's webhook settings (URL: https://<backend>/api/payments/webhook)
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Orders are created in this currency; INR amounts are converted with the fixed DEMO rate below (not live FX).
PAYPAL_CURRENCY=USD
INR_PER_UNIT_PAYPAL_CURRENCY=83.00

# ===== Frontend (frontend/.env.local) =====
# NEXT_PUBLIC_API_URL=http://localhost:8000
